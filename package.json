{
  "name": "forja",
  "private": true,
  "version": "1.0.0",
  "description": "Trilha de estudos de engenharia de software: 30 tópicos ligados por dependência, exercícios com nota e plano de carreira.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "node --test --import ./tests/register.mjs --experimental-strip-types --no-warnings 'tests/**/*.test.ts'",
    "check": "npm test && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
